---
import Layout from '../components/Layout.astro';
import SidebarNav from '../components/SidebarNav.astro';
import BottomNav from '../components/BottomNav.astro';
import MainContent from '../components/MainContent.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MCPDiagram from '../components/MCPDiagram.astro';
import NextSteps from '../components/NextSteps.astro';
---

<Layout title="MCP Servers — AI Concepts Visualized" description="The Model Context Protocol: a universal standard for connecting AI agents to tools, data sources, and services.">
  <SidebarNav activeSlug="mcp-servers" />
  <BottomNav activeTab="agentic" />
  <MainContent>
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Agentic Use', href: '/agentic-use' },
      { label: 'MCP Servers' },
    ]} />

    <!-- Hero -->
    <header class="mb-12">
      <span class="inline-flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-teal" />
        <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Agentic Use</span>
      </span>
      <h1 class="text-2xl font-heading font-semibold text-near-black tracking-tight mb-3">
        MCP Servers
      </h1>
      <p class="text-base text-gray-500 leading-relaxed max-w-prose mb-4">
        The universal plug for AI tools.
      </p>
      <p class="text-sm text-gray-500 leading-relaxed max-w-prose">
        Imagine every app, database, and service had the same USB-C port — you could connect
        anything to anything. MCP is that for AI agents. It's a standardized protocol that lets
        any AI client talk to any MCP server, unlocking a world of tools and data without
        writing custom integrations for each one.
      </p>
    </header>

    <!-- Interactive visualization -->
    <div class="mb-12">
      <MCPDiagram />
    </div>

    <!-- What is MCP? -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        What is MCP?
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          The <strong>Model Context Protocol</strong> (MCP) is an open standard created by
          Anthropic that defines how AI models and agents communicate with external tools,
          data sources, and services. Just as HTTP standardized web communication and USB
          standardized hardware connections, MCP standardizes how AI agents access context.
        </p>
        <p>
          At its core, MCP defines a simple client-server architecture: the <em>client</em>
          (your AI agent or LLM interface) connects to <em>servers</em> (tools, databases,
          APIs) over a shared protocol. Each server advertises its capabilities — what tools
          it offers, what data it can provide — and the client can discover and use them
          on the fly.
        </p>
      </div>
    </section>

    <!-- Why it matters -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Why It Matters
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          Before MCP, every AI tool integration was a custom, fragile, one-off implementation.
          Want your agent to access GitHub? Write a custom connector. Want it to query a
          database? Write another one. Want Slack? Another one. This created a fragmented
          ecosystem where agents were siloed and hard to compose.
        </p>
        <p>
          MCP solves this by providing a single, universal interface. The benefits are
          transformative:
        </p>
      </div>

      <div class="mt-6 space-y-4">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Composability</h3>
            <p class="text-sm text-gray-500">
              Mix and match any MCP server with any MCP-compatible client. Your agent can
              simultaneously use a filesystem server, a database server, and a Slack server —
              all through the same protocol.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z" />
              <path d="M4 9h16" />
              <path d="M9 4v16" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Ecosystem Growth</h3>
            <p class="text-sm text-gray-500">
              Anyone can build an MCP server — from individual developers to enterprises.
              A thriving ecosystem of community-maintained servers already exists for
              databases, cloud platforms, developer tools, and more.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Discoverability</h3>
            <p class="text-sm text-gray-500">
              Clients automatically discover what tools a server offers. No manual
              configuration needed — connect a server and its capabilities appear
              instantly.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0110 0v4" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Security Boundaries</h3>
            <p class="text-sm text-gray-500">
              Each MCP server runs as an isolated process with its own permissions. The
              protocol includes built-in mechanisms for prompting user approval before
              sensitive operations.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        How It Works
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          MCP uses a JSON-RPC 2.0 message format over various transport layers. The
          protocol flow follows three phases:
        </p>
      </div>

      <div class="mt-6 space-y-4">
        <!-- Phase 1 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            1
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Initialize</h3>
            <p class="text-sm text-gray-500">
              The client connects to a server and sends an <code class="text-xs font-mono bg-gray-50 px-1 py-0.5 rounded">initialize</code>
              request. The server responds with its protocol version, capabilities, and
              identity. This handshake establishes the connection contract.
            </p>
          </div>
        </div>

        <!-- Phase 2 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            2
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Discover</h3>
            <p class="text-sm text-gray-500">
              The client calls <code class="text-xs font-mono bg-gray-50 px-1 py-0.5 rounded">tools/list</code> to discover
              what the server offers. The server returns a catalog of available tools with
              their names, descriptions, and parameter schemas. The client now knows exactly
              what it can do through this server.
            </p>
          </div>
        </div>

        <!-- Phase 3 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            3
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Execute</h3>
            <p class="text-sm text-gray-500">
              When the agent needs something, it sends a <code class="text-xs font-mono bg-gray-50 px-1 py-0.5 rounded">tools/call</code>
              request with the tool name and arguments. The server executes the tool and
              returns the result. The agent uses this information to continue its task.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 text-sm text-gray-500 leading-relaxed">
        <p>
          The interactive diagram above shows this architecture in action. Click on a server
          node to see its available tools, then click a tool to inspect the actual JSON-RPC
          request and response messages exchanged over the protocol.
        </p>
      </div>
    </section>

    <!-- Transport layers -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Transport Layers
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          MCP supports multiple transport mechanisms, each suited to different deployment
          scenarios:
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-teal">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
            </span>
            <h3 class="text-sm font-medium text-near-black">Stdio</h3>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed">
            Standard input/output pipe. Best for local servers running on the same machine.
            Simple, fast, and secure — the default for most MCP servers.
          </p>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-teal">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 2L2 22" />
                <path d="M20 2h2v2" />
                <path d="M20 22h2v-2" />
                <path d="M2 20l20-20" />
                <path d="M2 2v2" />
                <path d="M2 22l20-20" />
              </svg>
            </span>
            <h3 class="text-sm font-medium text-near-black">SSE</h3>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed">
            Server-Sent Events over HTTP. Enables remote servers — the client connects
            to a URL, and the server pushes updates. Ideal for cloud-hosted services.
          </p>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-teal">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83" />
              </svg>
            </span>
            <h3 class="text-sm font-medium text-near-black">Streamable HTTP</h3>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed">
            HTTP with streaming responses. Bidirectional communication over standard
            HTTP, making it easy to deploy behind proxies and load balancers.
          </p>
        </div>
      </div>
    </section>

    <!-- Real-world servers -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Real-World MCP Servers
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed mb-4">
        <p>
          The MCP ecosystem already includes hundreds of servers. Here are some of the
          most impactful categories:
        </p>
      </div>

      <div class="space-y-3">
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-medium text-near-black mb-1">📁 Filesystem</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Read, write, search, and manage files. Agents can browse codebases, edit configs,
            and analyze logs directly through MCP.
          </p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-medium text-near-black mb-1">🗄️ Databases</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            PostgreSQL, MySQL, SQLite, MongoDB — query databases, introspect schemas,
            and generate reports without writing SQL manually.
          </p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-medium text-near-black mb-1">🐙 Developer Tools</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            GitHub, GitLab, and other platforms expose repos, issues, PRs, and CI pipelines
            as MCP tools for agent-driven development workflows.
          </p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-medium text-near-black mb-1">💬 Communication</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Slack, Discord, and email servers let agents participate in conversations,
            send notifications, and automate communication workflows.
          </p>
        </div>
      </div>
    </section>

    <!-- MCP vs alternatives -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        MCP vs. Other Approaches
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          MCP isn't the only way to give agents access to tools — but it addresses key
          limitations of earlier approaches:
        </p>
      </div>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="py-2 pr-4 font-mono font-medium text-gray-400 uppercase tracking-wider">Approach</th>
              <th class="py-2 pr-4 font-mono font-medium text-gray-400 uppercase tracking-wider">Portability</th>
              <th class="py-2 pr-4 font-mono font-medium text-gray-400 uppercase tracking-wider">Discovery</th>
              <th class="py-2 font-mono font-medium text-gray-400 uppercase tracking-wider">Ecosystem</th>
            </tr>
          </thead>
          <tbody class="text-gray-600">
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 font-medium text-near-black">Custom API wrappers</td>
              <td class="py-2.5 pr-4">None</td>
              <td class="py-2.5 pr-4">Manual</td>
              <td class="py-2.5">Fragmented</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-2.5 pr-4 font-medium text-near-black">Plugin systems</td>
              <td class="py-2.5 pr-4">Client-locked</td>
              <td class="py-2.5 pr-4">Registry</td>
              <td class="py-2.5">Limited</td>
            </tr>
            <tr>
              <td class="py-2.5 pr-4 font-medium text-teal">MCP</td>
              <td class="py-2.5 pr-4 text-teal">Universal</td>
              <td class="py-2.5 pr-4 text-teal">Automatic</td>
              <td class="py-2.5 text-teal">Growing</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Getting started -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Getting Started
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          To use MCP in your own projects, you need an MCP-compatible client (like Claude
          Desktop, Cursor, or a custom agent framework) and one or more MCP servers.
        </p>
        <p>
          Most MCP servers are available as npm packages or can be installed from source.
          Configuration is typically a simple JSON file specifying the server command and
          transport settings:
        </p>
      </div>

      <div class="mt-4 rounded-md bg-near-black p-4">
        <pre class="text-[11px] font-mono text-white leading-relaxed overflow-x-auto whitespace-pre"><code><span style="color:#A3A3A3">{</span>
  <span style="color:#00C4B0">"mcpServers"</span>: <span style="color:#A3A3A3">{</span>
    <span style="color:#00C4B0">"filesystem"</span>: <span style="color:#A3A3A3">{</span>
      <span style="color:#00C4B0">"command"</span>: <span style="color:#FF6B50">"npx"</span>,
      <span style="color:#00C4B0">"args"</span>: <span style="color:#A3A3A3">[</span><span style="color:#FF6B50">"-y"</span>, <span style="color:#FF6B50">"@modelcontextprotocol/server-filesystem"</span>, <span style="color:#FF6B50">"/home/user/projects"</span><span style="color:#A3A3A3">]</span>
    <span style="color:#A3A3A3">}</span>,
    <span style="color:#00C4B0">"github"</span>: <span style="color:#A3A3A3">{</span>
      <span style="color:#00C4B0">"command"</span>: <span style="color:#FF6B50">"npx"</span>,
      <span style="color:#00C4B0">"args"</span>: <span style="color:#A3A3A3">[</span><span style="color:#FF6B50">"-y"</span>, <span style="color:#FF6B50">"@modelcontextprotocol/server-github"</span><span style="color:#A3A3A3">]</span>,
      <span style="color:#00C4B0">"env"</span>: <span style="color:#A3A3A3">{</span>
        <span style="color:#00C4B0">"GITHUB_PERSONAL_ACCESS_TOKEN"</span>: <span style="color:#FF6B50">"ghp_..."</span>
      <span style="color:#A3A3A3">}</span>
    <span style="color:#A3A3A3">}</span>
  <span style="color:#A3A3A3">}</span>
<span style="color:#A3A3A3">}</span></code></pre>
      </div>

      <div class="mt-3 text-xs text-gray-400">
        <p>
          With this config, your agent gains access to both filesystem operations and
          GitHub integration through a single standardized protocol.
        </p>
      </div>
    </section>

    <NextSteps
      accentColor="var(--color-teal)"
      items={[
        { label: 'Skills', href: '/skills', description: 'Reusable knowledge packages' },
        { label: 'Agent Demo', href: '/agent-demo', description: 'Everything comes together in action' },
      ]}
    />
  </MainContent>
</Layout>

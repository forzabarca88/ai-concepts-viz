---
import Layout from '../components/Layout.astro';
import SidebarNav from '../components/SidebarNav.astro';
import BottomNav from '../components/BottomNav.astro';
import MainContent from '../components/MainContent.astro';
import NextSteps from '../components/NextSteps.astro';
---

<Layout title="AI Concepts Visualized">
  <SidebarNav activeSlug="index" />
  <BottomNav activeTab="core" />
  <MainContent>
    <header class="mb-12">
      <h1 class="text-2xl font-heading font-semibold text-near-black tracking-tight mb-3">
        How Large Language Models Work
      </h1>
      <p class="text-base text-gray-500 leading-relaxed max-w-prose">
        An interactive guide to understanding modern AI — from the data that trains models
        to the agentic systems that put them to work. Explore each concept with visual
        explanations and live demos.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Core Concepts card -->
      <a
        href="/core-concepts"
        class="group block p-6 rounded-lg border border-gray-200 hover:border-blue-violet/40 hover:shadow-medium transition-all duration-200"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-blue-violet mb-3" />
        <h2 class="text-lg font-heading font-medium text-near-black mb-1">
          Core Concepts
        </h2>
        <p class="text-sm text-gray-500">
          Data, tokenization, and the parameters that define model capacity.
        </p>
      </a>

      <!-- Training Stages card -->
      <a
        href="/training-stages"
        class="group block p-6 rounded-lg border border-gray-200 hover:border-coral/40 hover:shadow-medium transition-all duration-200"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-coral mb-3" />
        <h2 class="text-lg font-heading font-medium text-near-black mb-1">
          Training Stages
        </h2>
        <p class="text-sm text-gray-500">
          From pre-training to SFT to preference tuning — the full pipeline.
        </p>
      </a>

      <!-- Agentic Use card -->
      <a
        href="/agentic-use"
        class="group block p-6 rounded-lg border border-gray-200 hover:border-teal/40 hover:shadow-medium transition-all duration-200"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-teal mb-3" />
        <h2 class="text-lg font-heading font-medium text-near-black mb-1">
          Agentic Use
        </h2>
        <p class="text-sm text-gray-500">
          Tool calling, skills, MCP servers, and autonomous agent demos.
        </p>
      </a>
    </div>

    <NextSteps
      accentColor="var(--color-blue-violet)"
      items={[
        { label: 'Core Concepts', href: '/core-concepts', description: 'Data, tokenization, and parameters' },
        { label: 'Training Stages', href: '/training-stages', description: 'Pre-training, SFT, and preference tuning' },
        { label: 'Agentic Use', href: '/agentic-use', description: 'Tool calling, skills, and MCP servers' },
      ]}
    />
  </MainContent>
</Layout>

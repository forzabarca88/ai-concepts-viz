---
import Layout from '../components/Layout.astro';
import SidebarNav from '../components/SidebarNav.astro';
import BottomNav from '../components/BottomNav.astro';
import MainContent from '../components/MainContent.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SkillGrid from '../components/SkillGrid.astro';
import NextSteps from '../components/NextSteps.astro';
---

<Layout title="Skills — AI Concepts Visualized" description="Reusable knowledge packages that teach AI agents domain-specific expertise — from coding patterns to data analysis workflows.">
  <SidebarNav activeSlug="skills" />
  <BottomNav activeTab="agentic" />
  <MainContent>
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Agentic Use', href: '/agentic-use' },
      { label: 'Skills' },
    ]} />

    <!-- Hero -->
    <header class="mb-12">
      <span class="inline-flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-teal" />
        <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Agentic Use</span>
      </span>
      <h1 class="text-2xl font-heading font-semibold text-near-black tracking-tight mb-3">
        Skills
      </h1>
      <p class="text-base text-gray-500 leading-relaxed max-w-prose mb-4">
        Special abilities the agent can learn.
      </p>
      <p class="text-sm text-gray-500 leading-relaxed max-w-prose">
        Think of skills as the courses an agent takes to become proficient in a domain. Just as a
        developer might take a course on React or SQL, an agent learns skills that teach it
        domain-specific expertise — from debugging code to analyzing data, from writing
        documentation to deploying applications.
      </p>
    </header>

    <!-- What are skills? -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        What Are Skills?
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          A skill is a reusable knowledge package that teaches an agent how to perform a specific
          task. It contains instructions, examples, and patterns that the agent internalizes to
          become proficient in that area.
        </p>
        <p>
          Skills are the bridge between a general-purpose language model and a specialized
          assistant. Without skills, an agent has broad but shallow knowledge. With skills, it
          gains deep expertise in specific domains.
        </p>
        <p>
          Each skill defines <em>what</em> the agent should do and <em>how</em> to do it —
          including the reasoning patterns, tools to use, and quality checks to apply.
        </p>
      </div>
    </section>

    <!-- How agents learn skills -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        How Agents Learn Skills
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          Skills are loaded into the agent's context at runtime — no retraining required.
          The skill's instructions become part of the system prompt, guiding the agent's
          behavior for that domain.
        </p>
      </div>

      <div class="mt-6 space-y-4">
        <!-- Step 1 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            1
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Skill Definition</h3>
            <p class="text-sm text-gray-500">
              A skill is defined as a structured document containing instructions, examples,
              and context about when and how to apply the skill.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            2
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Context Injection</h3>
            <p class="text-sm text-gray-500">
              The skill document is injected into the agent's context window, typically as
              part of the system prompt or as a referenced file.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            3
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Pattern Recognition</h3>
            <p class="text-sm text-gray-500">
              The agent learns to recognize when a task matches the skill's domain and applies
              the learned patterns and procedures.
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm bg-teal/10 text-teal font-mono font-medium">
            4
          </div>
          <div>
            <h3 class="text-sm font-medium text-near-black mb-1">Skill Execution</h3>
            <p class="text-sm text-gray-500">
              The agent follows the skill's instructions, using associated tools and applying
              domain-specific reasoning to complete the task.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Types of skills -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Types of Skills
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          Skills span a wide range of domains. Here are the main categories:
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Coding -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">Coding</h3>
          </div>
          <p class="text-xs text-gray-500">
            Debugging, code review, refactoring, and test generation — everything needed to
            write and maintain quality software.
          </p>
        </div>

        <!-- Data Analysis -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">Data Analysis</h3>
          </div>
          <p class="text-xs text-gray-500">
            Statistical analysis, visualization, and data cleaning — turning raw data into
            actionable insights.
          </p>
        </div>

        <!-- Research -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">Research</h3>
          </div>
          <p class="text-xs text-gray-500">
            Web search, literature review, and fact-checking — finding and verifying
            information across sources.
          </p>
        </div>

        <!-- Creative -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">Creative</h3>
          </div>
          <p class="text-xs text-gray-500">
            Technical writing, brainstorming, and content generation — producing clear,
            engaging material.
          </p>
        </div>

        <!-- DevOps -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">DevOps</h3>
          </div>
          <p class="text-xs text-gray-500">
            Deployment, monitoring, and CI/CD pipelines — keeping systems running reliably
            in production.
          </p>
        </div>

        <!-- Communication -->
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-teal" />
            <h3 class="text-sm font-medium text-near-black">Communication</h3>
          </div>
          <p class="text-xs text-gray-500">
            Summarization, translation, and email drafting — conveying information clearly
            across audiences and languages.
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive skill registry -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Skill Registry
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        Browse the full catalog of skills below. Filter by category, search by name, and click
        any card to see full details.
      </p>
      <SkillGrid />
    </section>

    <!-- Skills vs tools -->
    <section class="mb-10">
      <h2 class="text-lg font-heading font-medium text-near-black tracking-tight mb-3">
        Skills vs. Tools
      </h2>
      <div class="text-sm text-gray-500 leading-relaxed space-y-3">
        <p>
          It's easy to confuse skills with tools, but they serve different purposes:
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Skills column -->
        <div class="rounded-lg border border-teal/20 bg-teal/5 p-5">
          <h3 class="text-sm font-medium text-teal mb-2">Skills</h3>
          <p class="text-xs text-gray-500 mb-3">
            Knowledge and expertise the agent <em>learns</em>.
          </p>
          <ul class="list-none space-y-1.5">
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-teal mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Teaches <em>how</em> to do something</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-teal mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Contains reasoning patterns</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-teal mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Lives in the context window</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-teal mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>No execution — just guidance</span>
            </li>
          </ul>
        </div>

        <!-- Tools column -->
        <div class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-medium text-near-black mb-2">Tools</h3>
          <p class="text-xs text-gray-500 mb-3">
            Actions the agent can <em>invoke</em>.
          </p>
          <ul class="list-none space-y-1.5">
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-gray-400 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Provides <em>capability</em> to act</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-gray-400 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Has a schema with parameters</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-gray-400 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Executed by the runtime</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-gray-500">
              <span class="text-gray-400 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>Returns results to the agent</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-4 text-sm text-gray-500 leading-relaxed">
        <p>
          <strong>Skills guide the agent's reasoning; tools give it hands to act.</strong> The most
          capable agents combine both — using skills to know <em>what</em> to do and tools to
          <em>do</em> it.
        </p>
      </div>
    </section>

    <NextSteps
      accentColor="var(--color-teal)"
      items={[
        { label: 'Tool Calling', href: '/tool-calling', description: 'Giving the agent hands to act' },
        { label: 'MCP Servers', href: '/mcp-servers', description: 'The universal plug for AI tools' },
      ]}
    />
  </MainContent>
</Layout>

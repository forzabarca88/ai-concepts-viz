---
import Layout from '../../components/Layout.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import BottomNav from '../../components/BottomNav.astro';
import MainContent from '../../components/MainContent.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import NextSteps from '../../components/NextSteps.astro';
---

<Layout title="Training Stages — AI Concepts Visualized" description="From raw model to helpful assistant: pre-training, supervised fine-tuning, and preference tuning.">
  <SidebarNav activeSlug="training-stages" />
  <BottomNav activeTab="training" />
  <MainContent>
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Training Stages' },
    ]} />

    <!-- Hero -->
    <header class="mb-12">
      <span class="inline-flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-coral" />
        <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Section 2</span>
      </span>
      <h1 class="text-2xl font-heading font-semibold text-near-black tracking-tight mb-3">
        Training Stages
      </h1>
      <p class="text-base text-gray-500 leading-relaxed max-w-prose">
        A raw transformer model knows how to predict the next token — but it doesn't know how to be
        helpful. Through three stages of training, a base model becomes a capable assistant: first
        learning from vast corpora, then following instructions, and finally aligning to human
        preferences.
      </p>
    </header>

    <!-- Visual timeline -->
    <div class="mb-12">
      <div class="relative flex items-center justify-between px-4 md:px-8">
        <!-- Connecting line -->
        <div class="absolute top-5 left-8 right-8 h-0.5 bg-coral/20" />

        <!-- Stage 1: Pre-training -->
        <div class="relative flex flex-col items-center gap-2 z-10">
          <div class="w-10 h-10 rounded-full bg-coral/10 border-2 border-coral flex items-center justify-center">
            <span class="text-sm font-mono font-bold text-coral">1</span>
          </div>
          <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Pre-training</span>
        </div>

        <!-- Stage 2: SFT -->
        <div class="relative flex flex-col items-center gap-2 z-10">
          <div class="w-10 h-10 rounded-full bg-coral/10 border-2 border-coral flex items-center justify-center">
            <span class="text-sm font-mono font-bold text-coral">2</span>
          </div>
          <span class="text-xs font-mono uppercase tracking-widest text-gray-400">SFT</span>
        </div>

        <!-- Stage 3: Preference Tuning -->
        <div class="relative flex flex-col items-center gap-2 z-10">
          <div class="w-10 h-10 rounded-full bg-coral/10 border-2 border-coral flex items-center justify-center">
            <span class="text-sm font-mono font-bold text-coral">3</span>
          </div>
          <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Preference Tuning</span>
        </div>
      </div>
    </div>

    <!-- Concept cards -->
    <div class="space-y-4">
      <ConceptCard
        title="Pre-training"
        description="The foundation stage — a transformer devours trillions of tokens to learn language, facts, and reasoning patterns from raw text."
        href="/pre-training"
        accentColor="coral"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
        </svg>
      </ConceptCard>

      <ConceptCard
        title="Supervised Fine-Tuning"
        description="Teaching the model to follow instructions — curated Q&A pairs shape the base model into a helpful assistant."
        href="/sft"
        accentColor="coral"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h10M4 18h13" />
        </svg>
      </ConceptCard>

      <ConceptCard
        title="Preference Tuning"
        description="Aligning outputs to human values — reward models and RLHF steer the assistant toward safe, useful, and honest responses."
        href="/preference-tuning"
        accentColor="coral"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      </ConceptCard>
    </div>

    <NextSteps
      accentColor="var(--color-coral)"
      items={[
        { label: 'Agentic Use', href: '/agentic-use', description: 'Tool calling, skills, and autonomous agents' },
      ]}
    />
  </MainContent>
</Layout>

---
// SkillGrid — Interactive card grid for browsing agent skills.
// Features: category filter, search, expandable cards with details.
// Uses teal accent color. Data passed via data-* attributes.

import { SKILLS, SKILL_CATEGORIES, getAllCategories } from '../lib/skills-data';

interface Props {
  containerClass?: string;
}

const { containerClass = '' } = Astro.props;

// Serialize data for embedding in data attributes
const skillsJson = JSON.stringify(SKILLS);
const categoriesJson = JSON.stringify(SKILL_CATEGORIES);
const categoryKeys = getAllCategories();
---

<div
  data-skill-grid-root
  class={`rounded-lg border border-gray-200 bg-white shadow-subtle overflow-hidden ${containerClass}`}
  data-skills={skillsJson}
  data-categories={categoriesJson}
>
  <!-- Header -->
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
    <h3 class="text-sm font-heading font-medium text-near-black tracking-tight mb-1">
      Skill Registry
    </h3>
    <p class="text-xs text-gray-500">
      Browse and explore skills agents can learn. Click any card for details.
    </p>
  </div>

  <!-- Filter bar -->
  <div class="px-5 py-3 border-b border-gray-100">
    <div data-skill-filter-bar class="flex flex-col sm:flex-row gap-3">
      <!-- Category filter -->
      <div class="flex-1">
        <label class="block text-xs font-mono uppercase tracking-widest text-gray-400 mb-1.5">
          Category
        </label>
        <div data-category-filters role="group" aria-label="Filter by category" class="flex flex-wrap gap-1.5">
          <button
            type="button"
            data-category-btn
            data-category="all"
            aria-label="Show all skills"
            class="skill-cat-btn active"
          >
            All
          </button>
          {categoryKeys.map(cat => (
            <button
              type="button"
              data-category-btn
              data-category={cat}
              aria-label={`Filter by ${SKILL_CATEGORIES[cat].label}`}
              class="skill-cat-btn"
            >
              {SKILL_CATEGORIES[cat].label}
            </button>
          ))}
        </div>
      </div>

      <!-- Search -->
      <div class="sm:w-64">
        <label
          for="skill-search-input"
          class="block text-xs font-mono uppercase tracking-widest text-gray-400 mb-1.5"
        >
          Search
        </label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <path d="M21 21l-4.35-4.35" />
            </svg>
          </span>
          <input
            id="skill-search-input"
            data-skill-search
            type="search"
            placeholder="Search skills..."
            aria-label="Search skills by name, description, or tag"
            class="w-full pl-9 pr-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-md focus:border-teal focus:ring-1 focus:ring-teal/20 transition-colors duration-150 placeholder:text-gray-400"
          />
        </div>
      </div>
    </div>

    <!-- Result count -->
    <div class="mt-2">
      <span data-skill-count class="text-xs font-mono text-gray-400" aria-live="polite">
        {SKILLS.length} skills
      </span>
    </div>
  </div>

  <!-- Card grid -->
  <div data-skill-grid class="p-5">
    <div data-skill-cards role="list" aria-label="Skills grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Cards are rendered dynamically by JS -->
    </div>

    <!-- Empty state (hidden by default) -->
    <div data-skill-empty class="hidden py-12 text-center" role="status" aria-live="polite">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-gray-300 mb-3" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      <p class="text-sm text-gray-400">No skills match your search.</p>
    </div>
  </div>
</div>

<style>
  /* Category filter button */
  .skill-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid #E5E5E5;
    background: white;
    color: #737373;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .skill-cat-btn:hover {
    border-color: #00C4B0;
    color: #00C4B0;
  }

  .skill-cat-btn.active {
    border-color: #00C4B0;
    color: #00C4B0;
    background-color: #00C4B010;
  }

  /* Skill card */
  .skill-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 16px;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
    background: white;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .skill-card:hover {
    border-color: #00C4B0;
    box-shadow: 0 4px 12px rgba(0, 196, 176, 0.08);
    transform: translateY(-1px);
  }

  .skill-card.expanded {
    border-color: #00C4B0;
    box-shadow: 0 4px 12px rgba(0, 196, 176, 0.12);
  }

  /* Card icon */
  .skill-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    margin-bottom: 10px;
    color: #00C4B0;
    background-color: #00C4B012;
    flex-shrink: 0;
  }

  .skill-card-icon svg {
    width: 18px;
    height: 18px;
  }

  /* Card title */
  .skill-card-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: #1D1D1F;
    margin-bottom: 4px;
    transition: color 0.15s ease;
  }

  .skill-card:hover .skill-card-title {
    color: #00C4B0;
  }

  /* Card description */
  .skill-card-desc {
    font-size: 12px;
    line-height: 1.5;
    color: #737373;
    margin-bottom: 8px;
  }

  /* Card category badge */
  .skill-card-category {
    display: inline-block;
    font-size: 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #A3A3A3;
    background: #F7F7F7;
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Card tags */
  .skill-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  .skill-card-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    color: #00C4B0;
    background: #00C4B008;
    padding: 1px 6px;
    border-radius: 3px;
  }

  /* Expanded details panel */
  .skill-card-details {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #EFEFEF;
    font-size: 12px;
    line-height: 1.6;
    color: #525252;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s ease, opacity 0.2s ease, margin 0.3s ease, padding 0.3s ease;
  }

  .skill-card.expanded .skill-card-details {
    max-height: 200px;
    opacity: 1;
  }

  /* Expand indicator */
  .skill-card-expand {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3A3A3;
    transition: transform 0.2s ease, color 0.15s ease;
  }

  .skill-card:hover .skill-card-expand {
    color: #00C4B0;
  }

  .skill-card.expanded .skill-card-expand {
    transform: rotate(180deg);
    color: #00C4B0;
  }

  /* Fade in animation for cards */
  @keyframes skill-card-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .skill-card-fade-in {
    animation: skill-card-fade-in 0.25s ease forwards;
  }
</style>

<script>
  import type { SkillDefinition, SkillCategory } from '../lib/skills-data';
  import { SKILL_CATEGORIES } from '../lib/skills-data';

  interface SkillGridInstance {
    skills: SkillDefinition[];
    activeCategory: string;
    searchQuery: string;
    expandedId: string | null;
    root: HTMLElement;
  }

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function createSkillCardHTML(skill: SkillDefinition, isExpanded: boolean): string {
    const catInfo = SKILL_CATEGORIES[skill.category];
    const expandedClass = isExpanded ? ' expanded' : '';

    return `
      <div
        class="skill-card skill-card-fade-in${expandedClass}"
        data-skill-id="${escapeHtml(skill.id)}"
        tabindex="0"
        role="button"
        aria-expanded="${isExpanded}"
        aria-label="Expand ${escapeHtml(skill.name)}: ${escapeHtml(skill.description)}"
      >
        <!-- Expand indicator -->
        <span class="skill-card-expand">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </span>

        <!-- Icon -->
        <div class="skill-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="${escapeHtml(skill.icon)}" />
          </svg>
        </div>

        <!-- Title -->
        <h4 class="skill-card-title">${escapeHtml(skill.name)}</h4>

        <!-- Description -->
        <p class="skill-card-desc">${escapeHtml(skill.description)}</p>

        <!-- Category badge -->
        <span class="skill-card-category">${escapeHtml(catInfo.label)}</span>

        <!-- Tags -->
        <div class="skill-card-tags">
          ${skill.tags.map(tag => `<span class="skill-card-tag">${escapeHtml(tag)}</span>`).join('')}
        </div>

        <!-- Expanded details -->
        <div class="skill-card-details">
          <p>${escapeHtml(skill.details)}</p>
        </div>
      </div>
    `;
  }

  function getFilteredSkills(instance: SkillGridInstance): SkillDefinition[] {
    let filtered = instance.skills;

    // Filter by category
    if (instance.activeCategory !== 'all') {
      filtered = filtered.filter(s => s.category === instance.activeCategory);
    }

    // Filter by search
    if (instance.searchQuery) {
      const q = instance.searchQuery.toLowerCase().trim();
      filtered = filtered.filter(
        s =>
          s.name.toLowerCase().includes(q) ||
          s.description.toLowerCase().includes(q) ||
          s.tags.some(t => t.toLowerCase().includes(q))
      );
    }

    return filtered;
  }

  function renderGrid(instance: SkillGridInstance): void {
    const cardsContainer = instance.root.querySelector('[data-skill-cards]') as HTMLElement;
    const emptyState = instance.root.querySelector('[data-skill-empty]') as HTMLElement;
    const countEl = instance.root.querySelector('[data-skill-count]') as HTMLElement;

    const filtered = getFilteredSkills(instance);

    if (filtered.length === 0) {
      cardsContainer.innerHTML = '';
      cardsContainer.style.display = 'none';
      emptyState.classList.remove('hidden');
    } else {
      cardsContainer.style.display = '';
      emptyState.classList.add('hidden');

      // Stagger animation delay
      cardsContainer.innerHTML = filtered
        .map((skill, i) => createSkillCardHTML(skill, instance.expandedId === skill.id))
        .join('');

      // Apply staggered animation-delay via inline style on each card
      cardsContainer.querySelectorAll('.skill-card-fade-in').forEach((card: Element, i: number) => {
        (card as HTMLElement).style.animationDelay = `${i * 30}ms`;
      });
    }

    if (countEl) {
      countEl.textContent = `${filtered.length} skill${filtered.length !== 1 ? 's' : ''}`;
    }

    // Re-bind card click events
    cardsContainer.querySelectorAll('[data-skill-id]').forEach(card => {
      const handler = () => {
        const id = card.getAttribute('data-skill-id');
        if (instance.expandedId === id) {
          instance.expandedId = null;
        } else {
          instance.expandedId = id;
        }
        renderGrid(instance);
      };
      card.addEventListener('click', handler);
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handler();
        }
      });
    });
  }

  function init() {
    const roots = document.querySelectorAll('[data-skill-grid-root]');

    roots.forEach(root => {
      const skills = JSON.parse(root.dataset.skills || '[]');
      const instance: SkillGridInstance = {
        skills,
        activeCategory: 'all',
        searchQuery: '',
        expandedId: null,
        root,
      };

      // Category filter buttons
      const catBtns = root.querySelectorAll('[data-category-btn]');
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category');
          if (cat) {
            instance.activeCategory = cat;
            instance.expandedId = null;

            catBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-category') === cat));
            renderGrid(instance);
          }
        });
      });

      // Search input
      const searchInput = root.querySelector('[data-skill-search]') as HTMLInputElement;
      if (searchInput) {
        let debounceTimer: number | null = null;
        searchInput.addEventListener('input', () => {
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = window.setTimeout(() => {
            instance.searchQuery = searchInput.value;
            instance.expandedId = null;
            renderGrid(instance);
          }, 200);
        });
      }

      // Initial render
      renderGrid(instance);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

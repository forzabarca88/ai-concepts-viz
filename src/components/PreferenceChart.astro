---
// PreferenceChart — Interactive D3.js visualization for preference tuning / RLHF.
// Shows two response options side-by-side with reward score bars.
// Users click to vote between responses, updating the reward model.
// An animated preference curve shows alignment progress over training steps.
// Uses data-* attributes for reliable DOM element references.

interface Props {
  containerClass?: string;
}

const { containerClass = '' } = Astro.props;

import { PREFERENCE_PAIRS, generateAlignmentCurve } from '../lib/preference-data';

// Serialize data for embedding in data attributes
const pairsJson = JSON.stringify(PREFERENCE_PAIRS);
const curveJson = JSON.stringify(generateAlignmentCurve(PREFERENCE_PAIRS));
---

<div
  data-preference-chart-root
  class={`rounded-lg border border-gray-200 bg-white shadow-subtle overflow-hidden ${containerClass}`}
  data-pairs={pairsJson}
  data-curve={curveJson}
>
  <!-- Header -->
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
    <h3 class="text-sm font-heading font-medium text-near-black tracking-tight mb-1">
      Preference Tuning Demo
    </h3>
    <p class="text-xs text-gray-500">
      Vote on which response is better, then watch how the reward model learns from your preferences.
    </p>
  </div>

  <!-- Pair selector -->
  <div class="px-5 py-4 border-b border-gray-100">
    <label class="block text-xs font-mono uppercase tracking-widest text-gray-400 mb-2">
      Choose a comparison
    </label>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Preference comparison pairs" data-preference-pair-buttons>
      {PREFERENCE_PAIRS.map((pair, index) => (
        <button
          type="button"
          data-preference-pair-btn
          data-index={index}
          aria-label={`Compare: ${pair.category}`}
          class={[
            'px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 text-gray-600 bg-white hover:border-coral hover:text-coral transition-colors duration-150',
            index === 0 ? 'active' : '',
          ].join(' ')}
        >
          {pair.category}
        </button>
      ))}
    </div>
  </div>

  <!-- Prompt display -->
  <div class="px-5 py-3 border-b border-gray-100 bg-coral/6">
    <span class="text-xs font-mono uppercase tracking-widest text-coral mb-1 block">
      Prompt
    </span>
    <div
      data-preference-prompt
      class="text-sm font-medium text-near-black"
    >
      {PREFERENCE_PAIRS[0]?.prompt}
    </div>
  </div>

  <!-- Response comparison area -->
  <div class="px-5 py-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" role="group" aria-label="Response comparison">
      <!-- Response A -->
      <div
        data-preference-response-a
        class="rounded-lg border border-gray-200 bg-gray-50 p-4 cursor-pointer hover:border-coral/50 hover:bg-coral/6 transition-all duration-200"
      >
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Response A</span>
          <span
            data-preference-reward-a
            class="text-xs font-mono font-bold text-coral"
          >
            Reward: {PREFERENCE_PAIRS[0]?.rewardA.toFixed(1)}
          </span>
        </div>
        <div
          data-preference-text-a
          class="text-xs text-gray-600 leading-relaxed whitespace-pre-wrap mb-3 line-clamp-6"
        >
          {PREFERENCE_PAIRS[0]?.responseA}
        </div>
        <!-- Reward bar -->
        <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
          <div
            data-preference-bar-a
            class="h-full rounded-full transition-all duration-500 ease-out"
            style={`width: ${(PREFERENCE_PAIRS[0]?.rewardA ?? 0) * 10}%; background-color: var(--color-coral);`}
          />
        </div>
        <button
          type="button"
          data-preference-vote-a
          aria-label="Vote for Response A"
          class="mt-3 w-full py-1.5 text-xs font-medium rounded-md border border-coral/30 text-coral bg-coral/8 hover:bg-coral/14 transition-colors duration-150"
        >
          Vote A
        </button>
      </div>

      <!-- Response B -->
      <div
        data-preference-response-b
        class="rounded-lg border border-gray-200 bg-gray-50 p-4 cursor-pointer hover:border-coral/50 hover:bg-coral/6 transition-all duration-200"
      >
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Response B</span>
          <span
            data-preference-reward-b
            class="text-xs font-mono font-bold text-coral"
          >
            Reward: {PREFERENCE_PAIRS[0]?.rewardB.toFixed(1)}
          </span>
        </div>
        <div
          data-preference-text-b
          class="text-xs text-gray-600 leading-relaxed whitespace-pre-wrap mb-3 line-clamp-6"
        >
          {PREFERENCE_PAIRS[0]?.responseB}
        </div>
        <!-- Reward bar -->
        <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
          <div
            data-preference-bar-b
            class="h-full rounded-full transition-all duration-500 ease-out"
            style={`width: ${(PREFERENCE_PAIRS[0]?.rewardB ?? 0) * 10}%; background-color: var(--color-gray-400);`}
          />
        </div>
        <button
          type="button"
          data-preference-vote-b
          aria-label="Vote for Response B"
          class="mt-3 w-full py-1.5 text-xs font-medium rounded-md border border-coral/30 text-coral bg-coral/8 hover:bg-coral/14 transition-colors duration-150"
        >
          Vote B
        </button>
      </div>
    </div>
  </div>

  <!-- Reward model update feedback -->
  <div
    data-preference-feedback
    class="px-5 py-3 border-t border-gray-100 bg-coral/6 flex items-start gap-2"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-coral flex-shrink-0 mt-0.5"
    >
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
    </svg>
    <p data-preference-feedback-text class="text-xs text-gray-600 leading-relaxed">
      Click "Vote A" or "Vote B" to cast your preference. The reward model updates its scores based on your choice.
    </p>
  </div>

  <!-- Alignment progress chart -->
  <div class="border-t border-gray-100">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
      <h3 class="text-sm font-heading font-medium text-near-black tracking-tight mb-1">
        Alignment Progress
      </h3>
      <p class="text-xs text-gray-500">
        Watch how alignment improves as the model trains on more preference data.
      </p>
    </div>
    <div data-preference-curve-chart class="w-full" style="min-height: 200px;" />
    <div class="px-5 py-3 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span class="flex items-center gap-1.5">
          <span class="w-4 h-0.5 bg-coral inline-block" />
          Alignment score
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-4 h-0.5 border-b border-gray-300 inline-block" />
          Grid
        </span>
      </div>
      <div class="flex items-center gap-3">
        <button
          type="button"
          data-preference-curve-play
          aria-label="Play alignment progress animation"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-coral/30 text-coral bg-coral/8 hover:bg-coral/14 transition-colors duration-150"
        >
          <span data-preference-curve-play-icon aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5,3 19,12 5,21" />
            </svg>
          </span>
          <span data-preference-curve-play-label>Play</span>
        </button>
        <span data-preference-curve-score class="text-xs font-mono text-coral font-semibold" aria-live="polite">
          Score: —
        </span>
      </div>
    </div>
  </div>

  <!-- Vote history -->
  <div class="px-5 py-4 border-t border-gray-100 bg-gray-50">
    <h4 class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-2">Your votes</h4>
    <div data-preference-vote-history class="flex flex-wrap gap-2">
      <span class="text-xs text-gray-400 italic">No votes yet — start comparing!</span>
    </div>
  </div>
</div>

<style>
  /* Active pair button */
  [data-preference-pair-btn].active {
    border-color: #FF6B50;
    color: #FF6B50;
    background-color: #FF6B5010;
  }

  /* Voted response styling */
  [data-preference-response-a].voted {
    border-color: #FF6B50;
    background-color: #FF6B5008;
  }

  [data-preference-response-b].voted {
    border-color: #FF6B50;
    background-color: #FF6B5008;
  }

  /* Correct/incorrect vote feedback */
  [data-preference-response-a].correct,
  [data-preference-response-b].correct {
    border-color: #22C55E;
    background-color: #22C55E10;
  }

  [data-preference-response-a].incorrect,
  [data-preference-response-b].incorrect {
    border-color: #EF4444;
    background-color: #EF444410;
  }

  /* Vote badge */
  .vote-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
  }

  .vote-badge.correct {
    background-color: #22C55E15;
    color: #16A34A;
  }

  .vote-badge.incorrect {
    background-color: #EF444415;
    color: #DC2626;
  }

  /* Tooltip */
  .preference-tooltip {
    pointer-events: none;
    position: absolute;
    z-index: 10;
    border-radius: 6px;
    background: #1D1D1F;
    padding: 8px 12px;
    font-size: 11px;
    line-height: 1.5;
    color: white;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .preference-tooltip.visible {
    opacity: 1;
  }

  .preference-tooltip .tooltip-step {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: #FF6B50;
  }

  .preference-tooltip .tooltip-score {
    font-family: 'Inter', system-ui, sans-serif;
    color: #A3A3A3;
  }
</style>

<script>
  import * as d3 from 'd3';

  type ResponsePair = {
    id: number;
    prompt: string;
    responseA: string;
    responseB: string;
    rewardA: number;
    rewardB: number;
    chosen: 'A' | 'B';
    category: string;
  };

  type CurvePoint = { step: number; score: number };

  interface ChartState {
    pairs: ResponsePair[];
    curve: CurvePoint[];
    selectedPairIndex: number;
    votes: Record<number, 'A' | 'B'>;
    updatedRewards: Record<number, { rewardA: number; rewardB: number }>;
    curveVisibleCount: number;
    isPlaying: boolean;
    animationTimer: number | null;
    prefersReducedMotion: boolean;
  }

  // Coral accent
  const CORAL = '#FF6B50';
  const CORAL_LIGHT = '#FF6B5018';
  const CORAL_BG = '#FF6B5008';

  function initPreferenceChart(root: HTMLElement) {
    const pairs: ResponsePair[] = JSON.parse(root.dataset.pairs || '[]');
    const curve: CurvePoint[] = JSON.parse(root.dataset.curve || '[]');
    if (pairs.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const state: ChartState = {
      pairs,
      curve,
      selectedPairIndex: 0,
      votes: {},
      updatedRewards: {},
      curveVisibleCount: prefersReducedMotion ? curve.length : 0,
      isPlaying: false,
      animationTimer: null,
      prefersReducedMotion,
    };

    // DOM refs — pair comparison
    const pairButtons = root.querySelectorAll('[data-preference-pair-btn]') as NodeListOf<HTMLButtonElement>;
    const promptDisplay = root.querySelector('[data-preference-prompt]') as HTMLElement;
    const responseA = root.querySelector('[data-preference-response-a]') as HTMLElement;
    const responseB = root.querySelector('[data-preference-response-b]') as HTMLElement;
    const textA = root.querySelector('[data-preference-text-a]') as HTMLElement;
    const textB = root.querySelector('[data-preference-text-b]') as HTMLElement;
    const rewardA = root.querySelector('[data-preference-reward-a]') as HTMLElement;
    const rewardB = root.querySelector('[data-preference-reward-b]') as HTMLElement;
    const barA = root.querySelector('[data-preference-bar-a]') as HTMLElement;
    const barB = root.querySelector('[data-preference-bar-b]') as HTMLElement;
    const voteABtn = root.querySelector('[data-preference-vote-a]') as HTMLButtonElement;
    const voteBBtn = root.querySelector('[data-preference-vote-b]') as HTMLButtonElement;
    const feedbackText = root.querySelector('[data-preference-feedback-text]') as HTMLElement;

    // DOM refs — alignment curve
    const chartArea = root.querySelector('[data-preference-curve-chart]') as HTMLElement;
    const curvePlayBtn = root.querySelector('[data-preference-curve-play]') as HTMLButtonElement;
    const curvePlayIcon = root.querySelector('[data-preference-curve-play-icon]') as HTMLElement;
    const curvePlayLabel = root.querySelector('[data-preference-curve-play-label]') as HTMLElement;
    const curveScore = root.querySelector('[data-preference-curve-score]') as HTMLElement;

    // DOM refs — vote history
    const voteHistory = root.querySelector('[data-preference-vote-history]') as HTMLElement;

    if (!chartArea) return;

    // ── Pair comparison rendering ──────────────────

    function renderPair() {
      const pair = pairs[state.selectedPairIndex];
      if (!pair) return;

      const hasVote = state.votes[pair.id] !== undefined;
      const updated = state.updatedRewards[pair.id];

      // Update prompt
      if (promptDisplay) promptDisplay.textContent = pair.prompt;

      // Update response text
      if (textA) textA.textContent = pair.responseA;
      if (textB) textB.textContent = pair.responseB;

      // Update reward scores (use updated rewards if vote was cast)
      const rA = updated?.rewardA ?? pair.rewardA;
      const rB = updated?.rewardB ?? pair.rewardB;
      if (rewardA) rewardA.textContent = `Reward: ${rA.toFixed(1)}`;
      if (rewardB) rewardB.textContent = `Reward: ${rB.toFixed(1)}`;

      // Update reward bars
      if (barA) barA.style.width = `${rA * 10}%`;
      if (barB) barB.style.width = `${rB * 10}%`;

      // Color the winning bar coral, losing bar gray
      if (barA) barA.style.backgroundColor = rA > rB ? CORAL : '#A3A3A3';
      if (barB) barB.style.backgroundColor = rB > rA ? CORAL : '#A3A3A3';

      // Reset vote styling
      responseA?.classList.remove('voted', 'correct', 'incorrect');
      responseB?.classList.remove('voted', 'correct', 'incorrect');

      if (hasVote) {
        const vote = state.votes[pair.id];
        const isCorrect = vote === pair.chosen;
        const votedEl = vote === 'A' ? responseA : responseB;
        votedEl?.classList.add('voted', isCorrect ? 'correct' : 'incorrect');
      }

      // Update feedback text
      if (feedbackText) {
        if (hasVote) {
          const vote = state.votes[pair.id];
          const isCorrect = vote === pair.chosen;
          const delta = pair.chosen === 'A' ? rA - rB : rB - rA;
          feedbackText.textContent = isCorrect
            ? `✓ Correct! The reward model scores the preferred response ${delta.toFixed(1)} points higher.`
            : `✗ The reward model actually preferred the other response (delta: ${delta.toFixed(1)}). This is how the model learns from more data.`;
        } else {
          feedbackText.textContent = 'Click "Vote A" or "Vote B" to cast your preference. The reward model updates its scores based on your choice.';
        }
      }

      // Update active pair button
      pairButtons.forEach((btn, i) => {
        btn.classList.toggle('active', i === state.selectedPairIndex);
      });
    }

    // ── Vote handling ──────────────────────────────

    function castVote(choice: 'A' | 'B') {
      const pair = pairs[state.selectedPairIndex];
      if (!pair || state.votes[pair.id]) return; // already voted

      state.votes[pair.id] = choice;

      // Update rewards: boost the chosen response, reduce the rejected one
      const currentRewards = state.updatedRewards[pair.id] || { rewardA: pair.rewardA, rewardB: pair.rewardB };
      const boost = 0.5;
      state.updatedRewards[pair.id] = {
        rewardA: choice === 'A' ? currentRewards.rewardA + boost : currentRewards.rewardA - boost * 0.3,
        rewardB: choice === 'B' ? currentRewards.rewardB + boost : currentRewards.rewardB - boost * 0.3,
      };

      // Update vote history
      renderVoteHistory();

      // Re-render pair with updated rewards
      renderPair();
    }

    function renderVoteHistory() {
      if (!voteHistory) return;
      const voteEntries = Object.entries(state.votes);

      if (voteEntries.length === 0) {
        voteHistory.innerHTML = '<span class="text-xs text-gray-400 italic">No votes yet — start comparing!</span>';
        return;
      }

      voteHistory.innerHTML = '';
      voteEntries.forEach(([idStr, choice]) => {
        const id = parseInt(idStr, 10);
        const pair = pairs.find(p => p.id === id);
        if (!pair) return;

        const isCorrect = choice === pair.chosen;
        const badge = document.createElement('span');
        badge.className = `vote-badge ${isCorrect ? 'correct' : 'incorrect'}`;
        badge.textContent = `${pair.category}: ${choice} ${isCorrect ? '✓' : '✗'}`;
        voteHistory.appendChild(badge);
      });
    }

    // ── Event bindings for pair comparison ─────────

    pairButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        state.selectedPairIndex = i;
        renderPair();
      });
    });

    if (voteABtn) {
      voteABtn.addEventListener('click', () => castVote('A'));
    }

    if (voteBBtn) {
      voteBBtn.addEventListener('click', () => castVote('B'));
    }

    // ── Alignment curve SVG setup ──────────────────

    const margin = { top: 16, right: 24, bottom: 32, left: 44 };
    const containerWidth = chartArea.clientWidth || 800;
    const height = 200;
    const width = containerWidth - margin.left - margin.right;

    const svg = d3.select(chartArea)
      .append('svg')
      .attr('width', '100%')
      .attr('height', height + margin.top + margin.bottom)
      .attr('viewBox', `0 0 ${containerWidth} ${height + margin.top + margin.bottom}`)
      .attr('preserveAspectRatio', 'xMidYMid meet')
      .attr('role', 'img')
      .attr('aria-label', 'Alignment progress chart showing how model alignment improves over training steps')
      .style('display', 'block');

    const g = svg.append('g')
      .attr('transform', `translate(${margin.left},${margin.top})`);

    // Scales
    const maxStep = curve[curve.length - 1].step;
    const xScale = d3.scaleLinear()
      .domain([0, maxStep])
      .range([0, width]);

    const yScale = d3.scaleLinear()
      .domain([0.45, 1.0])
      .range([height, 0]);

    // Grid lines
    const gridGroup = g.append('g').attr('class', 'grid');
    yScale.ticks(4).forEach(tick => {
      gridGroup.append('line')
        .attr('x1', 0).attr('x2', width)
        .attr('y1', yScale(tick)).attr('y2', yScale(tick))
        .attr('stroke', '#E5E5E5').attr('stroke-width', 0.5);
    });

    // Axes
    g.append('g')
      .attr('transform', `translate(0,${height})`)
      .call(d3.axisBottom(xScale).ticks(8).tickFormat(d3.format('d')))
      .selectAll('text')
        .attr('fill', '#737373')
        .attr('font-family', "'JetBrains Mono', monospace")
        .attr('font-size', '10px');

    g.append('g')
      .call(d3.axisLeft(yScale).ticks(4).tickFormat(d => `${(d * 100).toFixed(0)}%`))
      .selectAll('text')
        .attr('fill', '#737373')
        .attr('font-family', "'JetBrains Mono', monospace")
        .attr('font-size', '10px');

    g.selectAll('.domain').attr('stroke', '#D4D4D4');
    g.selectAll('.tick line').attr('stroke', '#E5E5E5');

    // Axis labels
    g.append('text')
      .attr('x', width / 2).attr('y', height + 26)
      .attr('text-anchor', 'middle')
      .attr('fill', '#737373')
      .attr('font-family', "'Inter', system-ui, sans-serif")
      .attr('font-size', '11px')
      .text('Training Steps');

    g.append('text')
      .attr('transform', 'rotate(-90)')
      .attr('x', -height / 2).attr('y', -34)
      .attr('text-anchor', 'middle')
      .attr('fill', '#737373')
      .attr('font-family', "'Inter', system-ui, sans-serif")
      .attr('font-size', '11px')
      .text('Alignment');

    // Area fill under curve
    const area = d3.area<CurvePoint>()
      .x(d => xScale(d.step))
      .y0(height)
      .y1(d => yScale(d.score))
      .curve(d3.curveMonotoneX);

    g.append('path')
      .datum(curve)
      .attr('fill', CORAL_LIGHT)
      .attr('class', 'curve-area')
      .attr('d', area);

    // Line
    const line = d3.line<CurvePoint>()
      .x(d => xScale(d.step))
      .y(d => yScale(d.score))
      .curve(d3.curveMonotoneX);

    const linePath = g.append('path')
      .datum(curve)
      .attr('fill', 'none')
      .attr('stroke', CORAL)
      .attr('stroke-width', 2.5)
      .attr('stroke-linecap', 'round')
      .attr('stroke-linejoin', 'round')
      .attr('d', line)
      .attr('class', 'alignment-line');

    // Path animation setup
    const fullPath = linePath.node() as SVGPathElement;
    const totalLength = fullPath.getTotalLength();
    linePath
      .attr('stroke-dasharray', `${totalLength} ${totalLength}`)
      .attr('stroke-dashoffset', prefersReducedMotion ? '0' : totalLength);

    // Hover dot
    const dot = g.append('circle')
      .attr('r', 4.5)
      .attr('fill', CORAL)
      .attr('stroke', 'white')
      .attr('stroke-width', 2)
      .attr('opacity', 0);

    // Tooltip
    const tooltipEl = document.createElement('div');
    tooltipEl.className = 'preference-tooltip';
    tooltipEl.setAttribute('role', 'tooltip');
    chartArea.style.position = 'relative';
    chartArea.appendChild(tooltipEl);
    const tooltip = d3.select(tooltipEl);

    // Hover interaction
    g.append('rect')
      .attr('x', 0).attr('y', 0)
      .attr('width', width).attr('height', height)
      .attr('fill', 'transparent')
      .attr('pointer-events', 'all')
      .on('mousemove', function (event) {
        const [mx] = d3.pointer(event);
        const bisect = d3.bisector((d: CurvePoint) => d.step).left;
        const xVal = xScale.invert(mx);
        const idx = bisect(curve.slice(0, state.curveVisibleCount), xVal, 0);

        if (idx < 0 || idx >= state.curveVisibleCount) {
          dot.attr('opacity', 0);
          tooltip.classed('visible', false);
          return;
        }

        const d = curve[idx];
        dot.attr('cx', xScale(d.step)).attr('cy', yScale(d.score)).attr('opacity', 1);

        tooltip.html(
          `<div class="tooltip-step">Step ${d.step}</div>` +
          `<div class="tooltip-score">Alignment: ${(d.score * 100).toFixed(1)}%</div>`
        );

        const rect = chartArea.getBoundingClientRect();
        const svgEl = chartArea.querySelector('svg');
        if (!svgEl) return;
        const scale = rect.width / containerWidth;
        let tx = mx * scale + 16;
        let ty = yScale(d.score) * (rect.height / (height + margin.top + margin.bottom)) + margin.top * (rect.height / (height + margin.top + margin.bottom)) - 20;
        const tooltipRect = tooltipEl.getBoundingClientRect();
        if (tx + tooltipRect.width > rect.width) tx = mx * scale - tooltipRect.width - 16;

        tooltip.style('left', tx + 'px').style('top', ty + 'px').classed('visible', true);

        if (curveScore) curveScore.textContent = `Score: ${(d.score * 100).toFixed(1)}%`;
      })
      .on('mouseleave', () => {
        dot.attr('opacity', 0);
        tooltip.classed('visible', false);
      });

    // ── Curve animation controls ───────────────────

    function showPlayIcon() {
      if (curvePlayIcon) {
        curvePlayIcon.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21" /></svg>';
      }
    }

    function showPauseIcon() {
      if (curvePlayIcon) {
        curvePlayIcon.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" /><rect x="14" y="4" width="4" height="16" /></svg>';
      }
    }

    function startCurveAnimation() {
      if (state.curveVisibleCount >= state.curve.length) {
        state.isPlaying = false;
        showPlayIcon();
        if (curvePlayLabel) curvePlayLabel.textContent = 'Play';
        return;
      }

      state.isPlaying = true;
      showPauseIcon();
      if (curvePlayLabel) curvePlayLabel.textContent = 'Pause';

      function step() {
        if (!state.isPlaying || state.curveVisibleCount >= state.curve.length) {
          state.isPlaying = false;
          showPlayIcon();
          if (curvePlayLabel) curvePlayLabel.textContent = 'Play';
          linePath.attr('stroke-dashoffset', '0');
          return;
        }

        state.curveVisibleCount++;
        const visibleData = state.curve.slice(0, state.curveVisibleCount);

        // Update line
        linePath.datum(visibleData).attr('d', line);
        const currentPath = linePath.node() as SVGPathElement;
        const currentLength = currentPath.getTotalLength();
        linePath.attr('stroke-dasharray', `${currentLength} ${totalLength}`);
        linePath.attr('stroke-dashoffset', '0');

        // Update area
        (g.select('.curve-area') as d3.Selection<SVGPathElement, unknown, null, undefined>)
          .datum(visibleData).attr('d', area);

        // Update score display
        const current = state.curve[state.curveVisibleCount - 1];
        if (curveScore) curveScore.textContent = `Score: ${(current.score * 100).toFixed(1)}%`;

        state.animationTimer = window.setTimeout(step, prefersReducedMotion ? 10 : 80);
      }

      step();
    }

    function stopCurveAnimation() {
      state.isPlaying = false;
      if (state.animationTimer !== null) {
        clearTimeout(state.animationTimer);
        state.animationTimer = null;
      }
      showPlayIcon();
      if (curvePlayLabel) curvePlayLabel.textContent = 'Play';
    }

    // ── Curve event bindings ───────────────────────

    if (curvePlayBtn) {
      curvePlayBtn.addEventListener('click', () => {
        if (state.isPlaying) {
          stopCurveAnimation();
        } else {
          startCurveAnimation();
        }
      });
    }

    // ── Initial render ─────────────────────────────

    renderPair();

    // Auto-start curve animation
    if (state.prefersReducedMotion) {
      state.curveVisibleCount = state.curve.length;
      linePath.attr('stroke-dashoffset', '0');
      const current = state.curve[state.curve.length - 1];
      if (curveScore) curveScore.textContent = `Score: ${(current.score * 100).toFixed(1)}%`;
    } else {
      startCurveAnimation();
    }
  }

  // Initialize all instances
  function init() {
    document.querySelectorAll('[data-preference-chart-root]').forEach(root => {
      initPreferenceChart(root as HTMLElement);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
---
interface Props {
  activeSlug?: string;
}

const { activeSlug = '' } = Astro.props;

// Resolve internal links under the configured base (e.g. /ai-concepts-viz/ on GitHub Pages)
const base = (import.meta.env.BASE_URL ?? '').replace(/\/$/, '');
function link(href: string): string {
  return href.startsWith('/') ? `${base}${href}` : href;
}

// Section groups with accent colors
const sections = [
  {
    label: 'Core Concepts',
    accent: 'blue-violet',
    items: [
      { label: 'Overview', slug: 'core-concepts' },
      { label: 'Data', slug: 'data' },
      { label: 'Tokenization', slug: 'tokenization' },
      { label: 'Parameters', slug: 'parameters' },
    ],
  },
  {
    label: 'Training Stages',
    accent: 'coral',
    items: [
      { label: 'Overview', slug: 'training-stages' },
      { label: 'Pre-training', slug: 'pre-training' },
      { label: 'SFT', slug: 'sft' },
      { label: 'Preference Tuning', slug: 'preference-tuning' },
    ],
  },
  {
    label: 'Agentic Use',
    accent: 'teal',
    items: [
      { label: 'Overview', slug: 'agentic-use' },
      { label: 'Tool Calling', slug: 'tool-calling' },
      { label: 'Skills', slug: 'skills' },
      { label: 'MCP Servers', slug: 'mcp-servers' },
      { label: 'Agent Demo', slug: 'agent-demo' },
    ],
  },
];

function getAccentColor(accent: string): string {
  const map: Record<string, string> = {
    'blue-violet': 'var(--color-blue-violet)',
    coral: 'var(--color-coral)',
    teal: 'var(--color-teal)',
  };
  return map[accent] ?? 'var(--color-gray-400)';
}

function isActive(slug: string, activeSlug: string): boolean {
  if (activeSlug === '' && slug === 'index') return true;
  return slug === activeSlug;
}
---

<!-- Sidebar — visible on desktop, hidden below 768px -->
<aside
  class="sidebar-nav hidden md:block fixed top-0 left-0 z-30 h-screen w-[260px] bg-warm-white border-r border-gray-200 overflow-y-auto"
>
  <!-- Site title -->
  <div class="px-6 pt-8 pb-6">
    <a
      href={link('/')}
      class="block font-heading text-xl font-semibold text-near-black tracking-tight hover:text-blue-violet transition-colors duration-200"
    >
      AI Concepts
      <span class="block text-sm font-body font-normal text-gray-500 mt-0.5">Visualized</span>
    </a>
  </div>

  <!-- Nav sections -->
  <nav class="px-4 pb-8">
    {sections.map((section) => {
      const accentColor = getAccentColor(section.accent);
      return (
        <div class="mb-6">
          <!-- Section label with accent indicator -->
          <div class="flex items-center gap-2 mb-2 px-2">
            <span
              class="w-2 h-2 rounded-full flex-shrink-0"
              style={`background-color: ${accentColor};`}
            />
            <span class="text-xs font-mono uppercase tracking-widest text-gray-400">
              {section.label}
            </span>
          </div>

          <!-- Nav items -->
          <ul class="space-y-0.5">
            {section.items.map((item) => {
              const active = isActive(item.slug, activeSlug);
              return (
                <li>
                  <a
                    href={item.slug === '#' ? '#' : link(`/${item.slug}`)}
                    class={[
                      'block px-3 py-1.5 rounded-md text-sm font-body transition-all duration-200',
                      active
                        ? 'font-medium'
                        : 'font-normal text-gray-600 hover:text-near-black hover:bg-gray-100',
                    ].join(' ')}
                    style={active ? `color: ${accentColor}; background-color: ${accentColor}15;` : ''}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </nav>
</aside>

<style is:global>
  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar-nav::-webkit-scrollbar-thumb {
    background: var(--color-gray-300);
    border-radius: var(--radius-full);
  }
</style>

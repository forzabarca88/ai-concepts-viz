---
import { pipelineNodes, pipelineLinks, droppedLinks } from '../lib/data-pipeline';

interface Props {
  containerClass?: string;
}

const { containerClass = '' } = Astro.props;

// Serialize data to JSON strings for embedding in data attributes
const nodesJson = JSON.stringify(pipelineNodes);
const linksJson = JSON.stringify(pipelineLinks);
const droppedLinksJson = JSON.stringify(droppedLinks);
---

<div
  id="data-pipeline-viz"
  role="region"
  aria-label="Data pipeline visualization showing data flow from raw sources through curation, tokenization, filtering, deduplication, and final training dataset"
  class={`relative w-full overflow-hidden rounded-lg border border-gray-200 bg-white shadow-subtle ${containerClass}`}
  style="min-height: 420px;"
  data-nodes={nodesJson}
  data-links={linksJson}
  data-dropped={droppedLinksJson}
>
  <!-- Tooltip (hidden by default, positioned by JS) -->
  <div
    id="pipeline-tooltip"
    class="pointer-events-none absolute z-10 hidden rounded-md bg-near-black px-3 py-2 text-xs leading-relaxed text-white shadow-large"
    role="tooltip"
  >
    <div id="tooltip-title" class="font-semibold mb-0.5" />
    <div id="tooltip-body" class="text-gray-300" />
  </div>
</div>

<style>
  #data-pipeline-viz {
    --accent: #5E5CE6;
    --accent-light: #5E5CE612;
    --accent-medium: #5E5CE633;
  }
</style>

<script>
  import { initDataPipeline } from '../lib/data-pipeline-viz';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    const container = document.getElementById('data-pipeline-viz');
    if (!container) {
      if (import.meta.env.DEV) console.error('DataPipeline: container not found');
      return;
    }

    const nodes = JSON.parse(container.dataset.nodes || '[]');
    const links = JSON.parse(container.dataset.links || '[]');
    const dropped = JSON.parse(container.dataset.dropped || '[]');

    initDataPipeline(container, nodes, links, dropped);
  }
</script>

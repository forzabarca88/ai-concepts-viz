---
// MCPDiagram — Interactive visualization of the MCP client-server architecture.
// Shows the AI agent (client) connecting to multiple MCP servers.
// Animated message arrows for request/response flow.
// Interactive: click a server node to see its tools; click a tool to see request/response exchange.
// Uses teal accent color.

import { MCP_SERVERS, MCP_CLIENT, MCP_CONNECTIONS, PROTOCOL_MESSAGES } from '../lib/mcp-data';

interface Props {
  containerClass?: string;
}

const { containerClass = '' } = Astro.props;

// Serialize data for embedding in data attributes
const serversJson = JSON.stringify(MCP_SERVERS);
const clientJson = JSON.stringify(MCP_CLIENT);
const connectionsJson = JSON.stringify(MCP_CONNECTIONS);
const protocolJson = JSON.stringify(PROTOCOL_MESSAGES);
---

<div
  data-mcp-diagram-root
  class={`rounded-lg border border-gray-200 bg-white shadow-subtle overflow-hidden ${containerClass}`}
  data-servers={serversJson}
  data-client={clientJson}
  data-connections={connectionsJson}
  data-protocol={protocolJson}
  style="min-height: 480px;"
>
  <!-- Header -->
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
    <h3 class="text-sm font-heading font-medium text-near-black tracking-tight mb-1">
      MCP Architecture
    </h3>
    <p class="text-xs text-gray-500">
      Client ↔ Server — click a server to inspect its tools, then click a tool to see the protocol exchange.
    </p>
  </div>

  <!-- SVG container -->
  <div data-mcp-svg-container class="relative w-full" style="min-height: 380px;" />

  <!-- Tool list panel (hidden until a server is selected) -->
  <div data-mcp-tool-panel class="hidden px-5 py-4 border-t border-gray-100 bg-gray-50">
    <div class="flex items-center justify-between mb-3">
      <h4 data-mcp-panel-title class="text-sm font-heading font-medium text-near-black tracking-tight">
        Tools
      </h4>
      <button type="button" data-mcp-close-panel aria-label="Close tool panel" class="text-xs font-mono text-gray-400 hover:text-teal transition-colors">
        ✕ Close
      </button>
    </div>
    <div data-mcp-tool-list role="list" aria-label="Available tools" class="space-y-2" />
  </div>

  <!-- Request/response detail panel (hidden until a tool is selected) -->
  <div data-mcp-detail-panel class="hidden px-5 py-4 border-t border-gray-100 bg-gray-50">
    <div class="flex items-center justify-between mb-3">
      <h4 data-mcp-detail-title class="text-sm font-heading font-medium text-near-black tracking-tight">
        Protocol Exchange
      </h4>
      <button type="button" data-mcp-close-detail aria-label="Close protocol detail" class="text-xs font-mono text-gray-400 hover:text-teal transition-colors">
        ✕ Close
      </button>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-gray-400 mb-1.5">Request</div>
        <pre data-mcp-request class="text-[10px] font-mono leading-relaxed bg-near-black text-white p-3 rounded-md overflow-x-auto whitespace-pre-wrap" />
      </div>
      <div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-gray-400 mb-1.5">Response</div>
        <pre data-mcp-response class="text-[10px] font-mono leading-relaxed bg-near-black text-white p-3 rounded-md overflow-x-auto whitespace-pre-wrap" />
      </div>
    </div>
  </div>
</div>

<style>
  [data-mcp-diagram-root] {
    --mcp-teal: #00C4B0;
    --mcp-teal-light: #00C4B012;
    --mcp-teal-medium: #00C4B033;
    --mcp-teal-dark: #00C4B080;
  }

  /* SVG node styling */
  .mcp-node {
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .mcp-node:hover {
    filter: brightness(1.05);
  }

  .mcp-node.active {
    filter: drop-shadow(0 0 8px var(--mcp-teal-dark));
  }

  /* Tool button styling */
  .mcp-tool-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid #E5E5E5;
    background: white;
    color: #737373;
    cursor: pointer;
    transition: all 0.15s ease;
    width: 100%;
    text-align: left;
  }

  .mcp-tool-btn:hover {
    border-color: var(--mcp-teal);
    color: var(--mcp-teal);
  }

  .mcp-tool-btn.active {
    border-color: var(--mcp-teal);
    color: var(--mcp-teal);
    background-color: var(--mcp-teal-light);
  }

  .mcp-tool-btn .tool-icon {
    font-size: 14px;
    flex-shrink: 0;
  }

  .mcp-tool-btn .tool-desc {
    font-size: 11px;
    color: #A3A3A3;
    font-weight: 400;
  }

  .mcp-tool-btn.active .tool-desc {
    color: var(--mcp-teal);
  }
</style>

<script>
  import * as d3 from 'd3';
  import { MCP_SERVERS, MCP_CLIENT, MCP_CONNECTIONS, PROTOCOL_MESSAGES } from '../lib/mcp-data';

  type MCPServer = typeof MCP_SERVERS[number];
  type MCPTool = MCPServer['tools'][number];
  type MCPConnection = typeof MCP_CONNECTIONS[number];

  interface DiagramState {
    selectedServerId: string | null;
    selectedToolId: string | null;
  }

  function initDiagram(root: HTMLElement): void {
    const servers: MCPServer[] = JSON.parse(root.dataset.servers || '[]');
    const client = JSON.parse(root.dataset.client || '{}');
    const connections: MCPConnection[] = JSON.parse(root.dataset.connections || '[]');
    const protocol = JSON.parse(root.dataset.protocol || '{}');

    const state: DiagramState = {
      selectedServerId: null,
      selectedToolId: null,
    };

    const svgContainer = root.querySelector('[data-mcp-svg-container]') as HTMLElement;
    const toolPanel = root.querySelector('[data-mcp-tool-panel]') as HTMLElement;
    const toolList = root.querySelector('[data-mcp-tool-list]') as HTMLElement;
    const panelTitle = root.querySelector('[data-mcp-panel-title]') as HTMLElement;
    const closePanelBtn = root.querySelector('[data-mcp-close-panel]') as HTMLElement;
    const detailPanel = root.querySelector('[data-mcp-detail-panel]') as HTMLElement;
    const detailTitle = root.querySelector('[data-mcp-detail-title]') as HTMLElement;
    const requestPre = root.querySelector('[data-mcp-request]') as HTMLElement;
    const responsePre = root.querySelector('[data-mcp-response]') as HTMLElement;
    const closeDetailBtn = root.querySelector('[data-mcp-close-detail]') as HTMLElement;

    if (!svgContainer || !toolPanel || !toolList) {
      if (import.meta.env.DEV) console.error('MCPDiagram: required DOM elements not found');
      return;
    }

    // Check reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Layout config ──────────────────────────────────────────
    const width = 800;
    const height = 380;
    const nodeW = 100;
    const nodeH = 56;

    // Client positioned on the left
    const clientX = 60;
    const clientY = height / 2 - nodeH / 2;

    // Servers in a column on the right
    const serverX = width - 60 - nodeW;
    const serverSpacing = (height - nodeH) / (servers.length + 1);
    const serverPositions: Record<string, { x: number; y: number }> = {};

    servers.forEach((server, i) => {
      serverPositions[server.id] = {
        x: serverX,
        y: serverSpacing * (i + 1) + nodeH / 2 - serverSpacing,
      };
    });

    // ── Create SVG ─────────────────────────────────────────────
    const svg = d3.select(svgContainer)
      .append('svg')
      .attr('width', '100%')
      .attr('height', '100%')
      .attr('viewBox', `0 0 ${width} ${height}`)
      .attr('preserveAspectRatio', 'xMidYMid meet')
      .attr('role', 'img')
      .attr('aria-label', 'MCP architecture diagram showing client connected to multiple MCP servers')
      .style('display', 'block');

    // Defs for shadow
    svg.append('defs')
      .append('filter')
      .attr('id', 'mcp-node-shadow')
      .append('feDropShadow')
      .attr('dx', 0)
      .attr('dy', 1)
      .attr('stdDeviation', 2)
      .attr('flood-color', 'rgba(0,0,0,0.06)');

    // ── Draw connections (lines from client to each server) ────
    const connectionGroup = svg.append('g').attr('class', 'mcp-connections');

    connections.forEach((conn) => {
      const targetPos = serverPositions[conn.target];
      if (!targetPos) return;

      const sx = clientX + nodeW;
      const sy = clientY + nodeH / 2;
      const tx = targetPos.x;
      const ty = targetPos.y + nodeH / 2;
      const mx = (sx + tx) / 2;

      // Curved path
      const path = connectionGroup
        .append('path')
        .attr('d', `M ${sx} ${sy} C ${mx} ${sy}, ${mx} ${ty}, ${tx} ${ty}`)
        .attr('fill', 'none')
        .attr('stroke', '#00C4B0')
        .attr('stroke-width', 1.5)
        .attr('stroke-opacity', 0.2)
        .attr('data-source', conn.source)
        .attr('data-target', conn.target)
        .attr('class', 'mcp-connection');
    });

    // ── Animated particles along connections ───────────────────
    if (!prefersReducedMotion) {
      connections.forEach((conn) => {
        const pathEl = connectionGroup
          .selectAll('.mcp-connection')
          .filter(function () {
            const el = d3.select(this);
            return el.attr('data-target') === conn.target;
          })
          .node() as SVGPathElement | null;

        if (!pathEl) return;

        const pathLength = pathEl.getTotalLength();

        // Request particle (client → server)
        const reqParticle = svg
          .append('circle')
          .attr('r', 2.5)
          .attr('fill', '#00C4B0')
          .attr('opacity', 0)
          .attr('class', 'mcp-particle mcp-particle-req');

        // Response particle (server → client)
        const resParticle = svg
          .append('circle')
          .attr('r', 2)
          .attr('fill', '#00C4B0')
          .attr('opacity', 0)
          .attr('class', 'mcp-particle mcp-particle-res');

        const baseDuration = 2000;
        const baseDelay = Math.random() * 1500;

        function animateRequest() {
          reqParticle
            .attr('opacity', 0)
            .transition()
            .delay(baseDelay)
            .duration(baseDuration)
            .ease(d3.easeLinear)
            .attrTween('cx', () => {
              return (t: number) => {
                const point = pathEl.getPointAtLength(t * pathLength);
                return point.x;
              };
            })
            .attrTween('cy', () => {
              return (t: number) => {
                const point = pathEl.getPointAtLength(t * pathLength);
                return point.y;
              };
            })
            .attr('opacity', 0.6)
            .on('end', () => {
              // After request arrives, start response
              animateResponse();
            });
        }

        function animateResponse() {
          resParticle
            .attr('opacity', 0)
            .transition()
            .duration(baseDuration)
            .ease(d3.easeLinear)
            .attrTween('cx', () => {
              return (t: number) => {
                const point = pathEl.getPointAtLength((1 - t) * pathLength);
                return point.x;
              };
            })
            .attrTween('cy', () => {
              return (t: number) => {
                const point = pathEl.getPointAtLength((1 - t) * pathLength);
                return point.y;
              };
            })
            .attr('opacity', 0.4)
            .on('end', () => {
              // Restart request cycle
              animateRequest();
            });
        }

        animateRequest();
      });
    }

    // ── Draw client node ───────────────────────────────────────
    const nodeGroup = svg.append('g').attr('class', 'mcp-nodes');

    const allNodes = [
      { ...client, type: 'client' as const },
      ...servers.map(s => ({ ...s, type: 'server' as const })),
    ];

    const nodeSel = nodeGroup
      .selectAll('.mcp-node')
      .data(allNodes)
      .enter()
      .append('g')
      .attr('class', 'mcp-node')
      .attr('data-id', d => d.id)
      .attr('data-type', d => d.type)
      .attr('tabindex', d => d.type === 'server' ? '0' : null)
      .attr('role', d => d.type === 'server' ? 'button' : null)
      .attr('aria-label', d => d.type === 'server' ? `${d.name} server: ${d.tools.length} tools` : null)
      .attr('transform', d => {
        const pos = d.type === 'client'
          ? { x: clientX, y: clientY }
          : serverPositions[d.id];
        return `translate(${pos.x}, ${pos.y})`;
      });

    // Node background
    nodeSel
      .append('rect')
      .attr('width', nodeW)
      .attr('height', nodeH)
      .attr('rx', 10)
      .attr('ry', 10)
      .attr('fill', d => d.type === 'client' ? '#00C4B012' : '#FAFAF8')
      .attr('stroke', d => d.type === 'client' ? '#00C4B0' : '#D4D4D4')
      .attr('stroke-width', d => d.type === 'client' ? 2 : 1.5)
      .attr('filter', 'url(#mcp-node-shadow)')
      .attr('class', 'mcp-node-bg');

    // Node icon + label
    nodeSel
      .append('text')
      .attr('x', nodeW / 2)
      .attr('y', 22)
      .attr('text-anchor', 'middle')
      .attr('font-size', '14px')
      .text(d => d.icon);

    nodeSel
      .append('text')
      .attr('x', nodeW / 2)
      .attr('y', 40)
      .attr('text-anchor', 'middle')
      .attr('fill', d => d.type === 'client' ? '#00C4B0' : '#1D1D1F')
      .attr('font-family', "'Newsreader', Georgia, serif")
      .attr('font-size', '12px')
      .attr('font-weight', '600')
      .text(d => d.name);

    // Node description (small)
    nodeSel
      .append('text')
      .attr('x', nodeW / 2)
      .attr('y', 52)
      .attr('text-anchor', 'middle')
      .attr('fill', '#737373')
      .attr('font-family', "'Inter', system-ui, sans-serif")
      .attr('font-size', '8px')
      .text(d => {
        // Truncate long descriptions
        const desc = d.description;
        return desc.length > 28 ? desc.slice(0, 25) + '...' : desc;
      });

    // ── Interaction: click server to show tools ────────────────
    const handleServerClick = function (_event: MouseEvent, d: typeof allNodes[number]) {
      if (d.type === 'client') return;

      // Toggle selection
      if (state.selectedServerId === d.id) {
        state.selectedServerId = null;
        state.selectedToolId = null;
        nodeSel.selectAll('.mcp-node').classed('active', false);
        hidePanels();
        resetConnectionHighlight();
      } else {
        state.selectedServerId = d.id;
        state.selectedToolId = null;
        nodeSel.selectAll('.mcp-node').classed('active', false);
        d3.select(this).classed('active', true);
        highlightConnection(d.id);
        showToolPanel(d);
        hideDetailPanel();
      }
    };

    nodeSel
      .on('click', handleServerClick)
      .on('keydown', function (_event, d) {
        if (d.type === 'client') return;
        const keyEvent = _event as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          handleServerClick.call(this, _event, d);
        }
      })
      .on('mouseenter', function () {
        d3.select(this).select('.mcp-node-bg')
          .transition().duration(150)
          .attr('stroke-width', 2.5);
      })
      .on('mouseleave', function () {
        if (!d3.select(this).classed('active')) {
          d3.select(this).select('.mcp-node-bg')
            .transition().duration(150)
            .attr('stroke-width', d.type === 'client' ? 2 : 1.5);
        }
      });

    // Click on SVG background to deselect
    svg.on('click', function () {
      state.selectedServerId = null;
      state.selectedToolId = null;
      nodeSel.selectAll('.mcp-node').classed('active', false);
      hidePanels();
      resetConnectionHighlight();
    });

    // ── Panel interaction ──────────────────────────────────────
    if (closePanelBtn) {
      closePanelBtn.addEventListener('click', () => {
        state.selectedServerId = null;
        state.selectedToolId = null;
        nodeSel.selectAll('.mcp-node').classed('active', false);
        hidePanels();
        resetConnectionHighlight();
      });
    }

    if (closeDetailBtn) {
      closeDetailBtn.addEventListener('click', () => {
        state.selectedToolId = null;
        hideDetailPanel();
      });
    }

    // ── Helper functions ────────────────────────────────────────

    function showToolPanel(server: MCPServer) {
      toolPanel.classList.remove('hidden');
      if (panelTitle) panelTitle.textContent = `${server.icon} ${server.name} — Tools`;

      toolList.innerHTML = '';

      server.tools.forEach(tool => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mcp-tool-btn';
        btn.setAttribute('data-tool-id', tool.id);
        btn.setAttribute('data-server-id', server.id);
        btn.setAttribute('aria-label', `${tool.name}: ${tool.description}`);

        btn.innerHTML = `
          <span class="tool-icon" aria-hidden="true">🔧</span>
          <div>
            <div class="font-medium">${tool.name}</div>
            <div class="tool-desc">${tool.description}</div>
          </div>
        `;

        btn.addEventListener('click', () => {
          state.selectedToolId = tool.id;

          // Update active state on buttons
          toolList.querySelectorAll('.mcp-tool-btn').forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-tool-id') === tool.id);
          });

          // Show request/response detail
          showDetailPanel(tool, server);
        });

        toolList.appendChild(btn);
      });
    }

    function showDetailPanel(tool: MCPTool, server: MCPServer) {
      detailPanel.classList.remove('hidden');
      if (detailTitle) detailTitle.textContent = `${tool.name} — Protocol Exchange`;

      if (requestPre) {
        requestPre.textContent = tool.exampleRequest;
        // Syntax highlight
        highlightJson(requestPre);
      }

      if (responsePre) {
        responsePre.textContent = tool.exampleResponse;
        highlightJson(responsePre);
      }
    }

    function hidePanels() {
      toolPanel.classList.add('hidden');
      detailPanel.classList.add('hidden');
    }

    function hideDetailPanel() {
      detailPanel.classList.add('hidden');
    }

    function highlightConnection(serverId: string) {
      svg.selectAll('.mcp-connection')
        .transition().duration(200)
        .attr('stroke-opacity', 0.06)
        .attr('stroke-width', 1);

      svg.selectAll('.mcp-connection')
        .filter(function () {
          return d3.select(this).attr('data-target') === serverId;
        })
        .transition().duration(200)
        .attr('stroke-opacity', 0.5)
        .attr('stroke-width', 2.5);
    }

    function resetConnectionHighlight() {
      svg.selectAll('.mcp-connection')
        .transition().duration(300)
        .attr('stroke-opacity', 0.2)
        .attr('stroke-width', 1.5);
    }

    function highlightJson(pre: HTMLElement) {
      let text = pre.textContent || '';
      // Simple JSON syntax highlighting
      text = text
        .replace(/"([^"]+)"(\s*:)/g, '<span style="color:#00C4B0">"$1"</span>$2')
        .replace(/:\s*"([^"]+)"/g, ': <span style="color:#FF6B50">"$1"</span>')
        .replace(/:\s*(\d+\.?\d*)/g, ': <span style="color:#FF6B50">$1</span>')
        .replace(/:\s*(true|false|null)/g, ': <span style="color:#A3A3A3">$1</span>')
        .replace(/[{}[\]]/g, '<span style="color:#D4D4D4">$&</span>');
      pre.innerHTML = text;
    }
  }

  // ── Initialization ─────────────────────────────────────────────
  function init() {
    document.querySelectorAll('[data-mcp-diagram-root]').forEach(root => {
      initDiagram(root as HTMLElement);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      requestAnimationFrame(init);
    });
  } else {
    requestAnimationFrame(init);
  }
</script>

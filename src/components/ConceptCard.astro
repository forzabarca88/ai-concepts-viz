---
interface Props {
  title: string;
  description: string;
  href: string;
  accentColor: 'blue-violet' | 'coral' | 'teal';
}

const { title, description, href, accentColor } = Astro.props;

const accentMap: Record<string, string> = {
  'blue-violet': 'var(--color-blue-violet)',
  'coral': 'var(--color-coral)',
  'teal': 'var(--color-teal)',
};

const accent = accentMap[accentColor] ?? 'var(--color-gray-400)';
---

<a
  href={href}
  class="group block rounded-lg border border-gray-200 bg-white shadow-subtle transition-all duration-200 hover:-translate-y-1 hover:shadow-medium"
  style={`border-left: 3px solid ${accent};`}
>
  <div class="p-7">
    <!-- Icon -->
    <div
      class="mb-4 inline-flex items-center justify-center w-10 h-10 rounded-md"
      style={`color: ${accent}; background-color: ${accent}12;`}
    >
      <slot />
    </div>

    <!-- Title -->
    <h3
      class="text-lg font-heading font-medium text-near-black tracking-tight mb-2 transition-colors duration-200"
      style={`--accent-hover: ${accent};`}
    >
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-gray-500 leading-relaxed">
      {description}
    </p>
  </div>
</a>

<style>
  h3 {
    /* Default hover uses the card's accent color via CSS variable */
  }
  .group:hover h3 {
    color: var(--accent-hover);
  }
</style>

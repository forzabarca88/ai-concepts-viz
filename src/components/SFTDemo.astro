---
// SFTDemo — Interactive supervised fine-tuning demonstration.
// Side-by-side comparison: base model output (before SFT) vs instruction-following output (after SFT).
// Uses data-* attributes for reliable DOM element references (not scoped by Astro).

interface Props {
  containerClass?: string;
}

const { containerClass = '' } = Astro.props;

import { SFT_EXAMPLES } from '../lib/sft-data';

// Serialize data for embedding in data attribute
const dataJson = JSON.stringify(SFT_EXAMPLES);
---

<div
  data-sft-demo-root
  class={`rounded-lg border border-gray-200 bg-white shadow-subtle overflow-hidden ${containerClass}`}
  data-examples={dataJson}
>
  <!-- Header -->
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
    <h3 class="text-sm font-heading font-medium text-near-black tracking-tight mb-1">
      SFT Before &amp; After
    </h3>
    <p class="text-xs text-gray-500">
      Pick an instruction below, then toggle to see how fine-tuning transforms the model's output.
    </p>
  </div>

  <!-- Instruction selector -->
  <div class="px-5 py-4 border-b border-gray-100">
    <label
      for="sft-instruction-select"
      class="block text-xs font-mono uppercase tracking-widest text-gray-400 mb-2"
    >
      Choose an instruction
    </label>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Instruction examples" data-sft-instruction-buttons>
      {SFT_EXAMPLES.map((example, index) => (
        <button
          type="button"
          data-sft-instruction-btn
          data-index={index}
          aria-label={`Instruction: ${example.instruction}`}
          class={[
            'px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 text-gray-600 bg-white hover:border-coral hover:text-coral transition-colors duration-150',
            index === 0 ? 'active' : '',
          ].join(' ')}
        >
          {example.instruction}
        </button>
      ))}
    </div>
  </div>

  <!-- Toggle switch -->
  <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
    <span class="text-xs font-mono uppercase tracking-widest text-gray-400">
      Compare outputs
    </span>
    <div class="flex items-center gap-3">
      <span
        data-sft-label-before
        class="text-xs font-medium transition-colors duration-200"
      >
        Before SFT
      </span>
      <button
        type="button"
        data-sft-toggle
        role="switch"
        aria-checked="false"
        aria-label="Toggle between before and after SFT output"
        class="relative inline-flex items-center w-11 h-6 rounded-full bg-gray-200 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-coral focus-visible:ring-offset-2"
      >
        <span
          data-sft-toggle-knob
          class="inline-block w-4 h-4 rounded-full bg-white shadow-subtle transform transition-transform duration-200 translate-x-0"
        />
      </button>
      <span
        data-sft-label-after
        class="text-xs font-medium text-gray-400 transition-colors duration-200"
      >
        After SFT
      </span>
    </div>
  </div>

  <!-- Output display -->
  <div class="px-5 py-5">
    <!-- Instruction prompt -->
    <div class="mb-4">
      <span class="text-xs font-mono uppercase tracking-widest text-coral mb-1 block">
        Instruction
      </span>
      <div
        data-sft-instruction-display
        class="text-sm font-medium text-near-black bg-coral/8 rounded-md px-4 py-2 border border-coral/20"
      >
        {SFT_EXAMPLES[0]?.instruction}
      </div>
    </div>

    <!-- Model output -->
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span
          data-sft-output-label
          class="text-xs font-mono uppercase tracking-widest"
        >
          Model output — before SFT
        </span>
      </div>
      <div
        data-sft-output-display
        role="region"
        aria-label="Model output"
        aria-live="polite"
        class="text-sm text-gray-600 leading-relaxed whitespace-pre-wrap bg-gray-50 rounded-md px-4 py-3 border border-gray-100 min-h-[120px]"
      >
        {SFT_EXAMPLES[0]?.beforeSft}
      </div>
    </div>
  </div>

  <!-- Insight bar -->
  <div class="px-5 py-3 border-t border-gray-100 bg-coral/6">
    <div class="flex items-start gap-2">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-coral flex-shrink-0 mt-0.5"
      >
        <circle cx="12" cy="12" r="10" />
        <path d="M12 16v-4M12 8h.01" />
      </svg>
      <p
        data-sft-insight
        class="text-xs text-gray-600 leading-relaxed"
      >
        Notice how the SFT-tuned output is structured, focused, and directly addresses the
        instruction — while the base model just generates plausible text without following
        directions.
      </p>
    </div>
  </div>
</div>

<style>
  /* Active instruction button */
  [data-sft-instruction-btn].active {
    border-color: #FF6B50;
    color: #FF6B50;
    background-color: #FF6B5010;
  }

  /* Toggle switch styles */
  [data-sft-toggle][aria-checked='true'] {
    background-color: #FF6B50;
  }

  [data-sft-toggle][aria-checked='true'] [data-sft-toggle-knob] {
    transform: translateX(1.25rem);
  }

  /* Active label styling */
  [data-sft-label-before].active {
    color: #FF6B50;
  }

  [data-sft-label-after].active {
    color: #FF6B50;
  }

  /* Output label styling */
  [data-sft-output-label].before {
    color: #737373;
  }

  [data-sft-output-label].after {
    color: #FF6B50;
  }

  /* Output display styling transitions */
  [data-sft-output-display] {
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  [data-sft-output-display].after {
    background-color: #FF6B5008;
    border-color: #FF6B5020;
  }
</style>

<script>
  type SFTPair = {
    instruction: string;
    beforeSft: string;
    afterSft: string;
    category: string;
  };

  interface SFTState {
    examples: SFTPair[];
    selectedIndex: number;
    showAfter: boolean;
  }

  function initDemo(root: HTMLElement) {
    const examples: SFTPair[] = JSON.parse(root.dataset.examples || '[]');
    if (examples.length === 0) return;

    const state: SFTState = {
      examples,
      selectedIndex: 0,
      showAfter: false,
    };

    // DOM refs
    const instructionButtons = root.querySelectorAll('[data-sft-instruction-btn]') as NodeListOf<HTMLButtonElement>;
    const instructionDisplay = root.querySelector('[data-sft-instruction-display]') as HTMLElement;
    const outputDisplay = root.querySelector('[data-sft-output-display]') as HTMLElement;
    const outputLabel = root.querySelector('[data-sft-output-label]') as HTMLElement;
    const toggle = root.querySelector('[data-sft-toggle]') as HTMLButtonElement;
    const toggleKnob = root.querySelector('[data-sft-toggle-knob]') as HTMLElement;
    const labelBefore = root.querySelector('[data-sft-label-before]') as HTMLElement;
    const labelAfter = root.querySelector('[data-sft-label-after]') as HTMLElement;
    const insight = root.querySelector('[data-sft-insight]') as HTMLElement;

    if (!instructionDisplay || !outputDisplay || !outputLabel || !toggle) return;

    const INSIGHTS: Record<string, string[]> = {
      analytical: [
        'The SFT output is structured with clear headings and explains concepts at appropriate depth — the base model just lists facts.',
        'Notice the SFT output uses formatting (bold, lists) and anticipates what the reader needs to know next.',
        'The base model dumps information; the SFT-tuned model organizes it and guides the reader through it.',
      ],
      creative: [
        'The base model produces generic, formulaic verse. The SFT output shows genuine craft — specific imagery, emotional resonance, and a coherent narrative arc.',
        'SFT teaches the model to match tone and style to the task, not just generate plausible text.',
      ],
      practical: [
        'The base model hedges endlessly ("it depends"). The SFT output gives concrete, actionable suggestions organized by what you actually care about.',
        'SFT trains the model to be direct and useful rather than safe and vague.',
      ],
      technical: [
        'The base model lists generic debugging tips. The SFT output asks clarifying questions first — mimicking how a human expert would respond.',
        'SFT teaches the model to interact conversationally rather than just outputting information.',
      ],
    };

    function render() {
      const example = examples[state.selectedIndex];
      if (!example) return;

      // Update instruction display
      instructionDisplay.textContent = example.instruction;

      // Update output
      const output = state.showAfter ? example.afterSft : example.beforeSft;
      outputDisplay.textContent = output;

      // Update output label
      outputLabel.textContent = state.showAfter
        ? 'Model output — after SFT'
        : 'Model output — before SFT';
      outputLabel.className = `text-xs font-mono uppercase tracking-widest ${state.showAfter ? 'after' : 'before'}`;

      // Output display styling
      if (state.showAfter) {
        outputDisplay.classList.add('after');
      } else {
        outputDisplay.classList.remove('after');
      }

      // Toggle state
      if (toggle) {
        toggle.setAttribute('aria-checked', state.showAfter ? 'true' : 'false');
      }

      // Label active states
      if (labelBefore) {
        labelBefore.classList.toggle('active', !state.showAfter);
      }
      if (labelAfter) {
        labelAfter.classList.toggle('active', state.showAfter);
      }

      // Update insight
      if (insight) {
        const categoryInsights = INSIGHTS[example.category] || INSIGHTS['analytical'];
        const insightIndex = state.selectedIndex % categoryInsights.length;
        insight.textContent = categoryInsights[insightIndex];
      }

      // Update active instruction button
      instructionButtons.forEach((btn, i) => {
        btn.classList.toggle('active', i === state.selectedIndex);
      });
    }

    // Instruction button clicks
    instructionButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        state.selectedIndex = i;
        state.showAfter = false;
        render();
      });
    });

    // Toggle click
    toggle.addEventListener('click', () => {
      state.showAfter = !state.showAfter;
      render();
    });

    // Keyboard support for toggle
    toggle.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        state.showAfter = !state.showAfter;
        render();
      }
    });

    // Initial render
    render();
  }

  // Initialize all instances on the page
  function init() {
    document.querySelectorAll('[data-sft-demo-root]').forEach(root => {
      initDemo(root as HTMLElement);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

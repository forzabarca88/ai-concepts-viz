{
  "name": "ai-concepts-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "How Machines Talk — a friendly, interactive tour of large language models.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "verify": "npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@types/node": "26.3.0",
    "@types/three": "0.185.4",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
